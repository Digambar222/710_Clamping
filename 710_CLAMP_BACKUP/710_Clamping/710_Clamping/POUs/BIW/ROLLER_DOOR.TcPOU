      <LineId Id="183" Count="20" />
      <LineId Id="176" Count="0" />
      <LineId Id="205" Count="7" />
      <LineId Id="204" Count="0" />
      <LineId Id="213" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>